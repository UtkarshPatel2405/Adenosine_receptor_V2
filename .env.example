# Adenosine Selectivity Model — Environment Configuration
# Copy to .env and fill in values.

# Data paths (defaults to ./data/raw, ./data/processed)
# ADENOSINE_DATA_DIR=/absolute/path/to/data
# ADENOSINE_RAW_DATA_DIR=/absolute/path/to/data/raw
# ADENOSINE_PROCESSED_DATA_DIR=/absolute/path/to/data/processed
# ADENOSINE_MODELS_DIR=/absolute/path/to/models
# ADENOSINE_OUTPUTS_DIR=/absolute/path/to/outputs

# Logging
ADENOSINE_LOG_LEVEL=INFO

# MLflow tracking (optional — leave empty to disable)
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=adenosine-selectivity

# Conformal prediction
# MAPIE_CV_FOLDS=5
# MAPIE_CONFIDENCE=0.90

# Scaffold split
# SCAFFOLD_SPLIT_SEED=42
# SCAFFOLD_TEST_SIZE=0.2

# GPU device for GNN training
# CUDA_VISIBLE_DEVICES=0
